{
  "name": "state-management-comparison",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:jotai": "turbo run dev --filter=server --filter=jotai",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "postinstall": "lefthook install"
  },
  "devDependencies": {
    "@turbo/gen": "^2.6.1",
    "lefthook": "^2.0.4",
    "lint-staged": "^16.2.6",
    "prettier": "^3.6.2",
    "turbo": "^2.6.0",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "*.json": [
      "prettier --write"
    ],
    "/examples/**/*.{js,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "/packages/**/*.{js,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  }
}
